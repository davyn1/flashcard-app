# Generate both values with: python scripts/hash_password.py
# Keep the single quotes around the hash so '$' isn't treated as a variable.
APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
JWT_SECRET='replace-with-a-long-random-string-at-least-32-chars'
JWT_EXPIRE_DAYS=90

# SQLite for quick local dev; Postgres in docker-compose / production, e.g.
# DATABASE_URL=postgresql+psycopg://flashcards:flashcards@localhost:5432/flashcards
DATABASE_URL=sqlite:///./flashcards.db

# Comma-separated frontend origin(s) allowed by CORS (no trailing slash)
CORS_ORIGINS=http://localhost:5173

LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
